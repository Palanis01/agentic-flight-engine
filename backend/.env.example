# ── App ───────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flightengine

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...

# ── Flight Data Providers ────────────────────────────────────
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
DUFFEL_API_KEY=
SERPAPI_KEY=

# ── Push Notifications ────────────────────────────────────────
EXPO_ACCESS_TOKEN=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=./apns-key.p8

# ── Azure ────────────────────────────────────────────────────
AZURE_SERVICE_BUS_CONN=
AZURE_STORAGE_CONN=

# ── AWS ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SQS_QUEUE_URL=

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
